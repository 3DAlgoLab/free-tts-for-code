{
  "name": "free-tts-for-code",
  "displayName": "Free TTS for Code",
  "description": "Local text-to-speech using Piper — reads code aloud",
  "version": "0.1.9",
  "publisher": "3dalgolab-8201",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/3DAlgoLab/free-tts-for-code"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:free-tts.readAloud",
    "onCommand:free-tts.stopPlayback",
    "onCommand:free-tts.selectVoice",
    "onCommand:free-tts.downloadEngine"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Free TTS for Code",
      "properties": {
        "free-tts.voice": {
          "type": "string",
          "default": "en_US-hfc_female-medium",
          "description": "Voice model"
        },
        "free-tts.filter.normalizeWhitespace": {
          "type": "boolean",
          "default": true
        },
        "free-tts.filter.stripCarriageReturns": {
          "type": "boolean",
          "default": true
        },
        "free-tts.filter.stripControlChars": {
          "type": "boolean",
          "default": true
        },
        "free-tts.filter.stripUnicodeControl": {
          "type": "boolean",
          "default": true
        },
        "free-tts.filter.stripEmojis": {
          "type": "boolean",
          "default": true
        },
        "free-tts.filter.stripCodeSymbols": {
          "type": "boolean",
          "default": false
        },
        "free-tts.filter.customPatterns": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Custom regex patterns (e.g. ['\\bTODO\\b'] to delete, ['\\*\\*(.+?)\\*\\*:$1'] to unwrap markdown bold)"
        }
      }
    },
    "commands": [
      {
        "command": "free-tts.readAloud",
        "title": "Read Aloud",
        "category": "Free TTS"
      },
      {
        "command": "free-tts.stopPlayback",
        "title": "Stop Reading",
        "category": "Free TTS"
      },
      {
        "command": "free-tts.selectVoice",
        "title": "Select Voice",
        "category": "Free TTS"
      },
      {
        "command": "free-tts.downloadEngine",
        "title": "Download Engine & Voices",
        "category": "Free TTS"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorHasSelection",
          "command": "free-tts.readAloud",
          "group": "1_modification"
        },
        {
          "command": "free-tts.stopPlayback",
          "group": "1_modification"
        }
      ],
      "commandPalette": [
        {
          "command": "free-tts.readAloud"
        },
        {
          "command": "free-tts.stopPlayback"
        },
        {
          "command": "free-tts.selectVoice"
        },
        {
          "command": "free-tts.downloadEngine"
        }
      ]
    },
    "keybindings": [
      {
        "command": "free-tts.readAloud",
        "key": "ctrl+alt+q",
        "when": "editorTextFocus || terminalFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "tsx test/preprocess.test.ts"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.96.0",
    "tsx": "^4.7.0",
    "typescript": "^5.7.3"
  },
  "type": "module"
}
